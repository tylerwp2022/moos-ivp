//-------------------------------------------------
// NAME: M. Benjamin, MIT CSAIL (s1_alpha), adapted for pLLMAgent
// FILE: alpha.moos
//
// Blank LLM mission: no pre-programmed route. The helm only follows
// what the chat pane, the buttons or a map click posts. alpha.bhv
// documents the flag conventions the tools below rely on.
//-------------------------------------------------

ServerHost   = localhost
ServerPort   = 9000
Community    = alpha
MOOSTimeWarp = 1

// Forest Lake
LatOrigin  = 43.825300 
LongOrigin = -70.330400 

// MIT Sailing Pavilion (use this one)
// LatOrigin  = 42.358456 
// LongOrigin = -71.087589

//------------------------------------------
// Antler configuration  block
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 200

  Run = MOOSDB        @ NewConsole = false
  Run = pLogger       @ NewConsole = false
  Run = uSimMarineV22 @ NewConsole = false
  Run = pMarinePIDV22 @ NewConsole = false
  Run = pHelmIvP      @ NewConsole = false
  Run = pMarineViewer	@ NewConsole = false
  Run = uProcessWatch	@ NewConsole = false
  Run = pNodeReporter	@ NewConsole = false
  Run = pRealm	      @ NewConsole = false
  Run = pLLMAgent     @ NewConsole = false
  Run = pBehaviorTree @ NewConsole = false
}

//------------------------------------------
// pLogger config block

ProcessConfig = pLogger
{
  AppTick   = 8
  CommsTick = 8

  AsyncLog = true

  // For variables that are published in a bundle on their 
  // first post, explicitly declare their logging request
  Log = IVPHELM_LIFE_EVENT @ 0 NOSYNC
  Log = REPORT @ 0 NOSYNC
  Log = BHV_SETTINGS @ 0 NOSYNC
  Log = MISSION @ 0 NOSYNC

  LogAuxSrc = true
  WildCardLogging = true
  WildCardOmitPattern = *_STATUS
  WildCardOmitPattern = DB_VARSUMMARY
  WildCardOmitPattern = DB_RWSUMMARY
  // The boat idles between commands and the PID posts this at 20 Hz
  // the whole time it has no fresh DESIRED_* input.
  WildCardOmitPattern = PID_STALE
  WildCardExclusionLog = true
}

//------------------------------------------
// uProcessWatch config block

ProcessConfig = uProcessWatch
{
  AppTick   = 4
  CommsTick = 4

  watch_all = true
	nowatch   = uPokeDB*
	nowatch   = uQueryDB*
	nowatch   = uXMS*
	nowatch   = uMAC*
}

//------------------------------------------
// uSimMarineV22 config block

ProcessConfig = uSimMarineV22
{
  AppTick  	= 4
  CommsTick	= 4

  start_pos     = x=0, y=-20, heading=180, speed=0
  prefix        = NAV
  turn_rate     = 95
  thrust_map    = 0:0, 20:1, 40:2, 60:3, 80:4, 100:5
	turn_spd_loss = 0.4
}

//------------------------------------------
// pHelmIvP config block

ProcessConfig = pHelmIvP
{
  AppTick    = 4
  CommsTick  = 4

  behaviors  = alpha.bhv
  domain     = course:0:359:360
  domain     = speed:0:4:41

  // A parked helm clears every behavior's updates= variable (WPT_UPDATE,
  // RETURN_UPDATE) on each tick without applying it. Keep the helm in
  // DRIVE from launch and after an all-stop so updates always land;
  // with DEPLOY=false it just idles. MOOS_MANUAL_OVERRIDE=true still
  // parks it if an operator needs that.
  start_engaged   = true
  park_on_allstop = false
}

//------------------------------------------
// pMarinePID config block

ProcessConfig = pMarinePIDV22
{
  AppTick    = 20
  CommsTick  = 20

  verbose       = true
  depth_control = false

  // SIM_INSTABILITY = 20

  // Yaw PID controller
  yaw_pid_kp		 = 0.9
  yaw_pid_kd		 = 0.3
  yaw_pid_ki		 = 0.3
  yaw_pid_integral_limit = 0.07

  // Speed PID controller
  speed_pid_kp		 = 1.0
  speed_pid_kd		 = 0.0
  speed_pid_ki		 = 0.0
  speed_pid_integral_limit = 0.07

  //MAXIMUMS
  maxrudder    = 100
  maxthrust    = 100

  // A non-zero SPEED_FACTOR overrides use of SPEED_PID
  // Will set DESIRED_THRUST = DESIRED_SPEED * SPEED_FACTOR
  speed_factor = 20
}

//------------------------------------------
// pMarineViewer config block

ProcessConfig = pMarineViewer
{
  AppTick    = 4
  CommsTick  = 4

  tiff_file            = forrest19.tif
	//tiff_file            = MIT_SP.tif

  set_pan_x            = -90
  set_pan_y            = -280
  zoom                 = 0.65
  vehicle_shape_scale  = 1.5
  hash_delta           = 50
  hash_shade           = 0.22
  hash_viewable        = true

  trails_point_size   = 1

  // Appcast configuration
  appcast_height       = 75
  appcast_width        = 30
  appcast_viewable     = true
  appcast_color_scheme = indigo
  nodes_font_size      = xlarge
  procs_font_size      = xlarge
  appcast_font_size    = large

  // LLM chat pane (right edge), fed by pLLMAgent
  chat_viewable        = true
  chat_width           = 28       // drag the divider or Ctrl+] / Ctrl+[ to resize
  chat_input_lines     = 6        // the input grows to this many lines, then scrolls

  // Map clicks post the same flags as the goto and return tools:
  // left click drives alpha to that point, right click brings it home.
  left_context[goto] = BT_CMD=cancel
  left_context[goto] = DEPLOY=true
  left_context[goto] = MOOS_MANUAL_OVERRIDE=false
  left_context[goto] = RETURN=false
  left_context[goto] = WPT_UPDATE=points=$[XPOS],$[YPOS]

  right_context[return] = BT_CMD=cancel
  right_context[return] = DEPLOY=true
  right_context[return] = MOOS_MANUAL_OVERRIDE=false
  right_context[return] = RETURN=true

  scope  = LLM_STATUS
  scope  = IVPHELM_STATE
  scope  = DEPLOY
  scope  = RETURN
  scope  = WPT_UPDATE
  scope  = WPT_STAT
  scope  = MISSION
  scope  = BT_STATE
  scope  = BT_ACTIVE
  scope  = BT_LOG
  scope  = MVIEWER_LCLICK

  button_one   = STOP # BT_CMD=halt # DEPLOY=false # RETURN=false
  button_two   = RETURN # BT_CMD=cancel # DEPLOY=true # RETURN=true # MOOS_MANUAL_OVERRIDE=false
  button_three = SLOWER # WPT_UPDATE=speed=1.0 # RETURN_UPDATE=speed=1.0
  button_four  = FASTER # WPT_UPDATE=speed=3.0 # RETURN_UPDATE=speed=3.0

  action = MENU_KEY=stop # BT_CMD=halt # DEPLOY=false # RETURN=false
  action = MENU_KEY=return # BT_CMD=cancel # DEPLOY=true # RETURN=true # MOOS_MANUAL_OVERRIDE=false
}

//------------------------------------------
// pNodeReporter config block

ProcessConfig = pNodeReporter
{
  AppTick    = 2
  CommsTick	 = 2

  platform_type   = kayak
  platform_color  = yellow
  platform_length = 4
}


//------------------------------------------
// pLLMAgent config block
// The API key is read from the ANTHROPIC_API_KEY environment
// variable of the shell that runs launch.sh; it is never stored here.
//
// Every tool that moves the boat posts DEPLOY=true and releases
// MOOS_MANUAL_OVERRIDE in the same line as its WPT_UPDATE. A tool's
// posts go out in one mail batch, in order, so the helm is driving by
// the time it looks at the update. A bare WPT_UPDATE sent to a parked
// helm is discarded, which is how the survey version of this mission
// ignored "move alpha to 20,20".

ProcessConfig = pLLMAgent
{
  AppTick   = 4
  CommsTick = 4

  model           = claude-opus-5
  effort          = medium
  max_tokens      = 4096
  confirm_default = true


  watch = DEPLOY, RETURN, MOOS_MANUAL_OVERRIDE, IVPHELM_STATE, IVPHELM_ALLSTOP
  watch = NAV_X, NAV_Y, NAV_SPEED, NAV_HEADING, DESIRED_SPEED, DESIRED_HEADING
  watch = WPT_UPDATE, RETURN_UPDATE, WPT_STAT, WPT_INDEX, MISSION
  watch = IVPHELM_UPDATE_RESULT   // result=success or param_error for each update
  watch = BT_STATE, BT_ACTIVE, BT_EVENT, BT_LOG

  // Posts to this variable are validated and outlined before the
  // operator approves them; the node catalog joins the system prompt.
  bt_tree_var = BT_TREE
  system_prompt_file = prompts/alpha.txt   // mission facts; tool semantics come from the .cap files

  // Tools come from capability files: the standard set (goto, route,
  // return, stop, speed) is built in, moos-ivp-bt adds run_plan,
  // halt_plan and reply_plan, and a mission adds its own with
  //   capability_dir = capabilities
  // A tool that is also a plan leaf cancels the running plan first
  // (tool_cancels_plan, BT_CMD). Proposals draw their shapes on the
  // map until approved or declined, each part in the next color.
  view_color = orange, yellow, magenta, cyan, dodger_blue, white



  app_logging = true
}

//------------------------------------------
// pBehaviorTree config block
// Runs a plan pLLMAgent wrote, or a file:
//   uPokeDB alpha.moos BT_TREE_FILE=plans/box_and_home.xml
// A halted or failed plan idles the helm the way the stop tool does.
// BT_CMD=cancel halts without those flags, for a goto or return that
// is taking the boat over itself.

ProcessConfig = pBehaviorTree
{
  AppTick   = 4
  CommsTick = 4

  halt_flag = DEPLOY=false
  halt_flag = RETURN=false
  fail_flag = DEPLOY=false
  fail_flag = RETURN=false

  watch = DEPLOY, RETURN, MISSION, IVPHELM_STATE, NAV_X, NAV_Y, NAV_SPEED

  app_logging = true
}
