//-------------------------------------------------
// FILE: meta_vehicle.moos  (m2_alpha_llm)
//
// One simulated vehicle of the fleet, filled in by launch_vehicle.sh.
// The helm follows the same flags as s1_alpha_llm (targ_$(VNAME).bhv).
// The shoreside's pLLMAgent reaches this vehicle as DEPLOY_$(VNAME),
// BT_TREE_$(VNAME) and so on, which uFldShoreBroker delivers here as
// the bare variables; this vehicle's plans run in its own pBehaviorTree.
//-------------------------------------------------

ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community  = $(VNAME)

#include plugs.moos <origin_warp>

//------------------------------------------
// Antler configuration block

ProcessConfig = ANTLER
{
  MSBetweenLaunches = 50

  Run = MOOSDB          @ NewConsole = false
  Run = pLogger         @ NewConsole = false
  Run = uProcessWatch   @ NewConsole = false
  Run = pShare          @ NewConsole = false
  Run = pHostInfo       @ NewConsole = false
  Run = uFldNodeBroker  @ NewConsole = false
  Run = pNodeReporter   @ NewConsole = false
  Run = uSimMarineV22   @ NewConsole = false
  Run = pMarinePIDV22   @ NewConsole = false
  Run = pHelmIvP        @ NewConsole = false
  Run = pBehaviorTree   @ NewConsole = false
  Run = pRealm          @ NewConsole = false
}

#include plugs.moos <pShare>
#include plugs.moos <pHostInfo>
#include plugs.moos <uProcessWatch>

//------------------------------------------
// uFldNodeBroker config block
// Finds the shoreside and bridges to it. Up go the node report, the
// plan's map shapes, and this vehicle's status renamed with its own
// name (%(VNAME) is the uppercase VNAME), so the shoreside DB holds
// one copy per vehicle and pLLMAgent and the chat pane can tell whose
// it is. BT_CHAT keeps its source aux on the way, so an Ask stays a
// question.

ProcessConfig = uFldNodeBroker
{
  AppTick   = 1
  CommsTick = 1

  try_shore_host = pshare_route=$(SHORE_IP):$(SHORE_PSHARE)

  bridge = src=NODE_REPORT_LOCAL,  alias=NODE_REPORT
  bridge = src=NODE_MESSAGE_LOCAL, alias=NODE_MESSAGE
  bridge = src=VIEW_POINT
  bridge = src=VIEW_SEGLIST
  bridge = src=VIEW_POLYGON
  bridge = src=VIEW_CIRCLE
  bridge = src=VIEW_TEXTBOX
  bridge = src=BT_STATE,  alias=BT_STATE_%(VNAME)
  bridge = src=BT_ACTIVE, alias=BT_ACTIVE_%(VNAME)
  bridge = src=BT_CHAT,   alias=BT_CHAT_%(VNAME)
  bridge = src=BT_LOG,    alias=BT_LOG_%(VNAME)
  bridge = src=BT_REPORT, alias=BT_REPORT_%(VNAME)
  bridge = src=MISSION,   alias=MISSION_%(VNAME)
  bridge = src=IVPHELM_STATE, alias=IVPHELM_STATE_%(VNAME)
  bridge = src=IVPHELM_UPDATE_RESULT, alias=IVPHELM_UPDATE_RESULT_%(VNAME)
}

//------------------------------------------
// uSimMarineV22 config block

ProcessConfig = uSimMarineV22
{
  AppTick   = 4
  CommsTick = 4

  start_pos     = $(START_POS), speed=0
  prefix        = NAV
  turn_rate     = 95
  thrust_map    = 0:0, 20:1, 40:2, 60:3, 80:4, 100:5
  turn_spd_loss = 0.4
}

//------------------------------------------
// pHelmIvP config block

ProcessConfig = pHelmIvP
{
  AppTick    = 4
  CommsTick  = 4

  behaviors  = targ_$(VNAME).bhv
  domain     = course:0:359:360
  domain     = speed:0:4:41

  // A parked helm clears every behavior's updates= variable on each
  // tick without applying it. Keep the helm in DRIVE from launch and
  // after an all-stop so updates always land; with DEPLOY=false it
  // just idles. MOOS_MANUAL_OVERRIDE=true still parks it.
  start_engaged   = true
  park_on_allstop = false
}

//------------------------------------------
// pMarinePIDV22 config block

ProcessConfig = pMarinePIDV22
{
  AppTick    = 20
  CommsTick  = 20

  verbose       = true
  depth_control = false

  // Take control from launch, as m2_berta does. The PID otherwise
  // drives only after a MOOS_MANUAL_OVERRIDE=false, which the tools
  // post but a bare uPokeDB or a click on a fresh boat may not.
  active_start  = true

  yaw_pid_kp             = 0.9
  yaw_pid_kd             = 0.3
  yaw_pid_ki             = 0.3
  yaw_pid_integral_limit = 0.07

  speed_pid_kp             = 1.0
  speed_pid_kd             = 0.0
  speed_pid_ki             = 0.0
  speed_pid_integral_limit = 0.07

  maxrudder = 100
  maxthrust = 100

  // A non-zero SPEED_FACTOR overrides use of SPEED_PID
  speed_factor = 20
}

//------------------------------------------
// pNodeReporter config block

ProcessConfig = pNodeReporter
{
  AppTick    = 2
  CommsTick  = 2

  platform_type   = kayak
  platform_color  = $(COLOR)
  platform_length = 4
}

//------------------------------------------
// pBehaviorTree config block
// Runs a plan the shoreside's pLLMAgent wrote for this vehicle
// (BT_TREE_$(VNAME) there, BT_TREE here), or a file:
//   uPokeDB targ_shoreside.moos BT_TREE_FILE_$(VNAME)=plans/box_goto.xml
// A halted or failed plan idles the helm the way the stop tool does.
// view_prefix keeps this vehicle's shapes apart from the others' on
// the shoreside viewer.

ProcessConfig = pBehaviorTree
{
  AppTick   = 4
  CommsTick = 4

  halt_flag = DEPLOY=false
  halt_flag = RETURN=false
  fail_flag = DEPLOY=false
  fail_flag = RETURN=false

  watch = DEPLOY, RETURN, TASK, MISSION, IVPHELM_STATE, NAV_X, NAV_Y, NAV_SPEED

  capability_dir = helm      // the same sets and filters as pLLMAgent
  view_prefix    = bt_$(VNAME)_

  app_logging = true
}

//------------------------------------------
// pLogger config block

ProcessConfig = pLogger
{
  AppTick   = 8
  CommsTick = 8

  File          = LOG_%(VNAME)
  PATH          = ./
  AsyncLog      = true
  FileTimeStamp = true

  Log = IVPHELM_LIFE_EVENT @ 0 NOSYNC
  Log = REPORT @ 0 NOSYNC
  Log = BHV_SETTINGS @ 0 NOSYNC
  Log = MISSION @ 0 NOSYNC

  LogAuxSrc = true
  WildCardLogging = true
  WildCardOmitPattern = *_STATUS
  WildCardOmitPattern = DB_VARSUMMARY
  WildCardOmitPattern = DB_RWSUMMARY
  WildCardOmitPattern = PID_STALE
  WildCardOmitPattern = NODE_BROKER_PING
  WildCardOmitPattern = PHI_HOST*
  WildCardExclusionLog = true
}
