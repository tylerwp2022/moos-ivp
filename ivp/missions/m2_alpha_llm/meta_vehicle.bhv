//--------    FILE: meta_vehicle.bhv  (m2_alpha_llm)   -------------
//
// One vehicle of the fleet, filled in by launch_vehicle.sh: the
// s1_alpha_llm helm with this vehicle's own return point. The flags
// below arrive from the shoreside as DEPLOY_$(VNAME) etc., delivered
// here as the bare names by uFldShoreBroker.
//
// Blank mission: no pre-programmed route. Nothing here moves the
// boat until the operator or pLLMAgent posts one of these:
//
//   goto / route : DEPLOY=true, RETURN=false, TASK=waypoint, WPT_UPDATE=points=...
//   loiter       : DEPLOY=true, RETURN=false, TASK=loiter, LOITER_UPDATE=polygon=...
//   station_keep : DEPLOY=true, RETURN=false, TASK=station, STATION_UPDATE=station_pt=...
//   hold_heading : DEPLOY=true, RETURN=false, TASK=heading, HEADING_UPDATE=heading=...
//   formation    : DEPLOY=true, RETURN=false, TASK=formation, TRAIL_UPDATE=contact=...
//                  (uFldSquad: hold a slot on the squad's virtual leader)
//   follow       : DEPLOY=true, RETURN=false, TASK=convoy, CONVOY_UPDATE=contact=...
//   intercept    : DEPLOY=true, RETURN=false, TASK=intercept, INTERCEPT_UPDATE=contact=...,
//                  INTERCEPT_SPEED_UPDATE=max_speed=...
//   return       : DEPLOY=true, RETURN=true
//   stop         : DEPLOY=false
//   speed        : WPT_UPDATE=speed=..., RETURN_UPDATE=..., LOITER_UPDATE=..., HEADING_SPEED_UPDATE=...
//
// TASK names the driver, so one post selects it and deselects the
// rest. The waypoint behaviors clear DEPLOY when they finish, so the
// helm idles (all-stop, boat coasts to a halt) until the next
// command; loiter, station-keep and hold-heading run until the next
// command. Modifiers ride on top of any driver, each on its own
// flag: OPREGION, PERIODIC_SPEED, TURN_LIMIT (op_region and friends),
// and AVOID = colregs | basic | off picks the collision avoidance
// (the avoid capability), off at launch; BHV_ABLE_FILTER =
// action=disable,contact=<name> leaves one contact out of it
// (avoid_ignore), enable + able put it back (avoid_heed).

initialize   DEPLOY = false
initialize   RETURN = false
initialize   TASK = none
initialize   OPREGION = false
initialize   PERIODIC_SPEED = false
initialize   TURN_LIMIT = false
initialize   AVOID = off

//----------------------------------------------
Behavior = BHV_Waypoint
{
  name      = waypt_goto
  pwt       = 100
  condition = DEPLOY = true
  condition = RETURN = false
  condition = TASK = waypoint
  endflag   = DEPLOY = false
  endflag   = MISSION = goto_complete
  updates   = WPT_UPDATE
  perpetual = true

  points         = empty     // idle until a WPT_UPDATE arrives
  speed          = 2.0       // m/s, changed by WPT_UPDATE=speed=...
  lead           = 8
  lead_damper    = 1
  lead_to_start  = true
  capture_line   = true
  capture_radius = 5.0
  slip_radius    = 15.0
  order          = normal
  repeat         = 0

  visual_hints = nextpt_color=yellow, nextpt_vertex_size=8, nextpt_lcolor=gray70
  visual_hints = vertex_color=dodger_blue, edge_color=white
  visual_hints = vertex_size=5, edge_size=1
}

//----------------------------------------------
Behavior = BHV_Waypoint
{
  name      = waypt_return
  pwt       = 100
  condition = DEPLOY = true
  condition = RETURN = true
  endflag   = RETURN = false
  endflag   = DEPLOY = false
  endflag   = MISSION = return_complete
  updates   = RETURN_UPDATE
  perpetual = true

  points         = $(RETURN_POS)   // this vehicle's launch position
  speed          = 2.0
  lead           = 8
  lead_damper    = 1
  lead_to_start  = true
  capture_line   = true
  capture_radius = 3.0
  slip_radius    = 10.0
}

//----------------------------------------------
// loiter: circles the polygon LOITER_UPDATE hands it, until the next
// command. The radius here is the vertex capture radius, not the
// circle: that comes with the polygon.
Behavior = BHV_Loiter
{
  name      = loiter
  pwt       = 100
  condition = DEPLOY = true
  condition = RETURN = false
  condition = TASK = loiter
  updates   = LOITER_UPDATE
  perpetual = true

  polygon   = format=radial,x=0,y=-60,radius=20,pts=8   // replaced by LOITER_UPDATE
  speed     = 2.0                                       // changed by LOITER_UPDATE=speed=...
  clockwise = best
  radius    = 4.0
  nm_radius = 15.0

  visual_hints = nextpt_color=yellow, nextpt_vertex_size=8
  visual_hints = edge_color=white, vertex_color=dodger_blue, vertex_size=3
}

//----------------------------------------------
// station_keep: holds the point STATION_UPDATE hands it. The radii
// are collapsed on purpose and set wider than the boat's turning
// circle: outside 10 m the boat drives at transit_speed, inside it
// cuts thrust and coasts to a stop. The behavior's usual ramp (speed
// falling to zero between outer and inner radius) would leave the
// boat creeping at a few tenths of a m/s, and uSimMarineV22's turn
// rate falls with speed, so a boat nudged toward a point from inside
// the ramp cannot turn onto it and circles it. At 1.2 m/s these boats
// turn at about 6 deg/s, a radius near 7.5 m: a smaller inner radius
// is unreachable from a curved approach and the boat orbits it at
// exactly that radius, so 10 m lets the first pass enter and stop.
Behavior = BHV_StationKeep
{
  name      = station
  pwt       = 100
  condition = DEPLOY = true
  condition = RETURN = false
  condition = TASK = station
  updates   = STATION_UPDATE
  perpetual = true

  station_pt    = $(RETURN_POS)  // replaced by STATION_UPDATE
  inner_radius  = 10
  outer_radius  = 10
  outer_speed   = 1.2
  transit_speed = 1.2
  swing_time    = 4

  visual_hints = vertex_size=0, edge_color=gray50
}

//----------------------------------------------
// hold_heading: this pair. ConstantHeading defaults to a zero
// duration, which would end it at once, so both say no-time-limit.
Behavior = BHV_ConstantHeading
{
  name      = const_heading
  pwt       = 100
  condition = DEPLOY = true
  condition = RETURN = false
  condition = TASK = heading
  updates   = HEADING_UPDATE
  perpetual = true
  duration  = no-time-limit

  heading   = 0              // replaced by HEADING_UPDATE
}

Behavior = BHV_ConstantSpeed
{
  name      = const_speed
  pwt       = 100
  condition = DEPLOY = true
  condition = RETURN = false
  condition = TASK = heading
  updates   = HEADING_SPEED_UPDATE
  perpetual = true
  duration  = no-time-limit

  speed     = 2.0            // replaced by HEADING_SPEED_UPDATE
}

//----------------------------------------------
// formation: hold a slot relative to a contact, the squad's virtual
// leader (<squad>_lead) that uFldSquad posts to this vehicle as a
// NODE_REPORT. TRAIL_UPDATE names the contact and the slot as a range
// and an angle; the angle is relative to the leader's heading (+90
// starboard, 180 astern) or a compass bearing (trail_angle_type =
// absolute) for a formation that keeps a fixed orientation. No
// contact line here: a placeholder name would draw a warning every
// tick until the first update.
Behavior = BHV_Trail
{
  name      = formation
  pwt       = 100
  condition = DEPLOY = true
  condition = RETURN = false
  condition = TASK = formation
  updates   = TRAIL_UPDATE
  perpetual = true

  trail_range      = 20        // replaced per slot by TRAIL_UPDATE
  trail_angle      = 180
  trail_angle_type = relative
  radius           = 3
  nm_radius        = 15
  pwt_outer_dist   = 0         // always relevant
  no_alert_request = true
  post_trail_dist_on_idle = false
}

//----------------------------------------------
// convoy: follow another vehicle along its own track (the follow
// capability, TASK = convoy). CONVOY_UPDATE names the leader and the
// distance to keep (rng_lagging); the leader's position comes from
// its node report into the helm's contact ledger. Between rng_tgating
// and rng_lagging the follower matches the leader's speed; farther
// back it closes up at spd_faster times that speed, closer it slows
// to spd_slower times it, and within rng_estop it stops. rng_safety
// is off so a 20 m spacing is allowed as asked; the capability says
// 15 m or more.
Behavior = BHV_Convoy
{
  name      = convoy
  pwt       = 100
  condition = DEPLOY = true
  condition = RETURN = false
  condition = TASK = convoy
  updates   = CONVOY_UPDATE
  perpetual = true

  rng_safety  = false
  rng_estop   = 5
  rng_tgating = 10
  rng_lagging = 20             // replaced per call by CONVOY_UPDATE
  spd_max     = 4
  spd_faster  = 1.3
  spd_slower  = 0.7
  radius      = 5
  nm_radius   = 10
  inter_mark_range = 5         // marks left along the leader's track
  max_mark_range   = 150
  on_no_contact_ok = true
}

//----------------------------------------------
// intercept: chase a contact and close on it (the intercept
// capability, TASK = intercept). BHV_CutRange steers to cut the range,
// leading a moving contact (patience: 0 is pure pursuit, pointing at
// it; higher weighs the closest point of approach over the next
// time_on_leg seconds instead). Its say is full beyond pwt_outer_dist
// and fades to nothing at pwt_inner_dist, which INTERCEPT_UPDATE sets
// to the range asked for: there the behavior falls silent and the
// boat coasts, hanging about that far off until the contact pulls
// away. It never completes by itself: a plan leaf ends on the
// executor's own contact range and idles the helm; a tool call runs
// until the next command. giveup_dist must be set (zero means the
// behavior never enters pursuit at all); this one is beyond the lake.
// With avoidance on, that block's standoff (20 m) holds the boat off
// first. No contact line: a placeholder would warn until the first
// update.
Behavior = BHV_CutRange
{
  name      = intercept
  pwt       = 100
  condition = DEPLOY = true
  condition = RETURN = false
  condition = TASK = intercept
  updates   = INTERCEPT_UPDATE
  perpetual = true

  pwt_outer_dist = 500
  pwt_inner_dist = 10          // replaced per call by INTERCEPT_UPDATE
  giveup_dist    = 5000
  patience       = 85
  time_on_leg    = 30
  extrapolate    = true
  decay          = 30,60
  on_no_contact_ok = true
}

// The chase's top speed: BHV_CutRange takes whatever speed the domain
// allows (4 m/s here) and the speed tool never reaches it, so the
// intercept capability's speed argument arrives here as max_speed,
// and this block outweighs everything else on the speed axis while
// the intercept drives. Two chases at 4 m/s coasted through a 10 m
// range into the target before it existed.
Behavior = BHV_MaxSpeed
{
  name      = chase_speed        // not intercept_*: the helm reads a name that extends
                                 // another (intercept) as a duplicate
  pwt       = 500
  condition = DEPLOY = true
  condition = RETURN = false
  condition = TASK = intercept
  updates   = INTERCEPT_SPEED_UPDATE

  max_speed = 2.0              // replaced per call by INTERCEPT_SPEED_UPDATE
  tolerance = 0.2
}

//----------------------------------------------
// avoidance: one instance per contact, spawned by pContactMgrV20 from
// the alert each template requests at helm start (alert at
// pwt_outer_dist, released at completed_dist), and gone again when
// the contact passes completed_dist. Both templates spawn for every
// contact; AVOID says which kind has a say, colregs (the rules of
// the road: give way, stand on, overtake, head on) or basic (keep
// the closest point of approach open, no rules). The say ramps from
// nothing at pwt_outer_dist to full pwt at pwt_inner_dist, well above
// the drivers (100) and below the fence (300): at 200 a crossing was
// a 15 m pass, the driver's pull taking a third; a maneuver is rated by
// its closest point of approach, worthless at min_util_cpa_dist and
// perfect at max_util_cpa_dist, which is the standoff a follow or an
// intercept cannot get inside while this is on, except against a
// contact the helm's able filter disabled (can_disable = true below,
// the avoid_ignore capability). The ramp starts at
// 70 m because two kayaks closing at 4 m/s need the give-way turn
// under way by 50 m to pass at 20; from 40 m it was an 8 m pass. The virtual leader
// of a formation is ignored by type, here and in the manager.
Behavior = BHV_AvdColregsV22
{
  name       = avd_colregs_
  pwt        = 250
  condition  = DEPLOY = true
  condition  = AVOID = colregs
  updates    = COLREGS_INFO
  templating = spawn

  contact          = to-be-set
  on_no_contact_ok = true
  extrapolate      = true
  decay            = 30,60
  ignore_type      = virtual
  can_disable      = true
  use_refinery     = true

  pwt_outer_dist    = 70
  pwt_inner_dist    = 40
  completed_dist    = 80
  min_util_cpa_dist = 10
  max_util_cpa_dist = $(STANDOFF)   // the standoff, from launch_vehicle.sh
  pwt_grade         = linear

  bearing_line_config     = white:0, green:0.65, yellow:0.8, red:1.0
  bearing_line_label_show = false
}

Behavior = BHV_AvoidCollision
{
  name       = avd_basic_
  pwt        = 250
  condition  = DEPLOY = true
  condition  = AVOID = basic
  updates    = AVOID_INFO
  templating = spawn

  contact          = to-be-set
  on_no_contact_ok = true
  extrapolate      = true
  decay            = 30,60
  ignore_type      = virtual
  can_disable      = true
  use_refinery     = true

  pwt_outer_dist    = 70
  pwt_inner_dist    = 40
  completed_dist    = 80
  min_util_cpa_dist = 10
  max_util_cpa_dist = $(STANDOFF)   // the standoff, from launch_vehicle.sh
  pwt_grade         = linear

  bearing_line_config     = white:0, green:0.65, yellow:0.8, red:1.0
  bearing_line_label_show = false
}

//----------------------------------------------
// op_region: a fence that turns the boat back, not a kill switch.
// It arms once the boat has been inside the polygon for
// trigger_entry_time. Inside, it has no say; the moment the boat
// crosses out (save_dist = 0) it outweighs the driver (pwt) and
// turns the boat back in at recover_spd, with no helm error. Leave
// halt_dist unset: with it the helm would halt with a BehaviorError
// that far out, as the classic BHV_OpRegion does at the first step.
// core_poly must be convex.
Behavior = BHV_OpRegionV24
{
  name      = opregion
  pwt       = 300
  condition = DEPLOY = true
  condition = OPREGION = true
  updates   = OPREGION_UPDATE

  core_poly = -100,40:100,40:100,-160:-100,-160   // replaced by OPREGION_UPDATE
  save_dist          = 0
  recover_spd        = 1.5
  trigger_entry_time = 1
  save_flag          = OPREGION_OUTSIDE = true

  visual_hints = edge_color=yellow, vertex_color=yellow, vertex_size=0, edge_size=1
}

//----------------------------------------------
// periodic_speed: period_busy seconds at the driver's speed, then
// period_lazy seconds at period_speed, repeating while the flag is up.
Behavior = BHV_PeriodicSpeed
{
  name      = periodic_speed
  pwt       = 100
  condition = DEPLOY = true
  condition = PERIODIC_SPEED = true
  updates   = PERIODIC_SPEED_UPDATE

  period_busy  = 60
  period_lazy  = 30
  period_speed = 0.5
}

//----------------------------------------------
// turn_limit: over the last memory_time seconds the heading stays
// within turn_range degrees, for a towed sensor.
Behavior = BHV_MemoryTurnLimit
{
  name      = turn_limit
  pwt       = 100
  condition = DEPLOY = true
  condition = TURN_LIMIT = true
  updates   = TURN_LIMIT_UPDATE

  memory_time = 60
  turn_range  = 150
}
