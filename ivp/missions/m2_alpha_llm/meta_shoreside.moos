//-------------------------------------------------
// FILE: meta_shoreside.moos  (m2_alpha_llm)
//
// The shoreside: pMarineViewer with the chat pane and pLLMAgent, plus
// the uField apps that connect the vehicles. Filled in by
// launch_shoreside.sh. Nothing here drives a boat directly: every
// command is a VAR_<VNAME> or VAR_ALL post that uFldShoreBroker
// bridges to the vehicle as the bare variable.
//-------------------------------------------------

ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community  = shoreside

#include plugs.moos <origin_warp>

//------------------------------------------
// Antler configuration block

ProcessConfig = ANTLER
{
  MSBetweenLaunches = 100

  Run = MOOSDB          @ NewConsole = false
  Run = pRealm          @ NewConsole = false
  Run = pLogger         @ NewConsole = false
  Run = uProcessWatch   @ NewConsole = false
  Run = pShare          @ NewConsole = false
  Run = pHostInfo       @ NewConsole = false
  Run = uFldShoreBroker @ NewConsole = false
  Run = uFldNodeComms   @ NewConsole = false
#ifndef NOGUI
  Run = pMarineViewer   @ NewConsole = false
  Run = uButtonPanel    @ NewConsole = false
#endif
  Run = pLLMAgent       @ NewConsole = false
  Run = pBehaviorTree   @ NewConsole = false
  Run = uPlanPreview    @ NewConsole = false
  Run = uFldSquad        @ NewConsole = false
  Run = uFldCollisionDetect @ NewConsole = false
}

#include plugs.moos <pShare>
#include plugs.moos <pHostInfo>
#include plugs.moos <uProcessWatch>

//------------------------------------------
// uFldShoreBroker config block
// qbridge = FOO bridges FOO_ALL and FOO_<VNAME> here to FOO on the
// vehicle. pLLMAgent's tools post the _<VNAME> forms (receivers =
// all:vname below) and pMarineViewer's buttons the _ALL forms.

ProcessConfig = uFldShoreBroker
{
  AppTick   = 1
  CommsTick = 1

  qbridge = DEPLOY, RETURN, MOOS_MANUAL_OVERRIDE, TASK
  qbridge = WPT_UPDATE, RETURN_UPDATE, LOITER_UPDATE, STATION_UPDATE
  qbridge = HEADING_UPDATE, HEADING_SPEED_UPDATE
  qbridge = OPREGION, OPREGION_UPDATE
  qbridge = PERIODIC_SPEED, PERIODIC_SPEED_UPDATE
  qbridge = TURN_LIMIT, TURN_LIMIT_UPDATE
  qbridge = BT_TREE, BT_TREE_FILE, BT_CMD, BT_REPLY, BT_SIGNAL
  qbridge = NODE_REPORT, NODE_MESSAGE
  qbridge = PLATFORM_COLOR, TRAIL_UPDATE    // uFldSquad: squad colors, formation slots
  qbridge = CONVOY_UPDATE, INTERCEPT_UPDATE, INTERCEPT_SPEED_UPDATE, AVOID   // the contact set
  qbridge = BHV_ABLE_FILTER                 // avoid_ignore / avoid_heed: one contact left out

  // Every vehicle's Report milestone (up as BT_REPORT_<VNAME>) goes
  // back down to every vehicle under that name, so a plan on one
  // vehicle can wait on another's milestone instead of its position.
  bridge = src=BT_REPORT_*

  auto_bridge_appcast = true
}

//------------------------------------------
// uFldCollisionDetect config block
// Counts encounters, near misses and collisions between vehicles
// from their node reports, for the operator and the agent (COLLISION
// and NEAR_MISS name the pair, the _TOTAL counts run up). The ranges
// suit 4 m boats; a pulse marks a collision on the map.

ProcessConfig = uFldCollisionDetect
{
  AppTick   = 4
  CommsTick = 4

  encounter_range = 20
  near_miss_range = 8
  collision_range = 4

  collision_flag = COLLISION = vname1=$V1,vname2=$V2,cpa=$CPA
  near_miss_flag = NEAR_MISS = vname1=$V1,vname2=$V2,cpa=$CPA

  encounter_rings = false
  pulse_render    = true
  pulse_range     = 20
  pulse_duration  = 10
}

//------------------------------------------
// uFldNodeComms config block

ProcessConfig = uFldNodeComms
{
  AppTick   = 2
  CommsTick = 2

  comms_range      = 500
  critical_range   = 25
  min_msg_interval = 15
  max_msg_length   = 1000
  groups           = true

  view_node_rpt_pulses = false
}

//------------------------------------------
// pLogger config block

ProcessConfig = pLogger
{
  AppTick   = 8
  CommsTick = 8

  File          = XLOG_SHORESIDE
  PATH          = ./
  AsyncLog      = true
  FileTimeStamp = true

  LogAuxSrc = true
  WildCardLogging = true
  WildCardOmitPattern = *_STATUS
  WildCardOmitPattern = DB_VARSUMMARY
  WildCardOmitPattern = DB_RWSUMMARY
  WildCardOmitPattern = NODE_BROKER_PING
  WildCardOmitPattern = PSHARE_INPUT_SUMMARY
  WildCardOmitPattern = PSHARE_OUTPUT_SUMMARY
  WildCardOmitPattern = PHI_HOST*
  WildCardExclusionLog = true
}

//------------------------------------------
// pMarineViewer config block

ProcessConfig = pMarineViewer
{
  AppTick    = 4
  CommsTick  = 4

  tiff_file            = forrest19.tif

  set_pan_x            = -90
  set_pan_y            = -280
  zoom                 = 0.65
  vehicles_shape_scale = 1.5
  vehicles_name_mode   = names
  hash_delta           = 50
  hash_shade           = 0.22
  hash_viewable        = true

  trails_point_size    = 1

  stale_report_thresh  = 10
  stale_remove_thresh  = 18

  // Appcast configuration
  appcast_height       = 75
  appcast_width        = 30
  appcast_viewable     = true
  appcast_color_scheme = indigo
  nodes_font_size      = xlarge
  procs_font_size      = xlarge
  appcast_font_size    = large

  // LLM chat pane (right edge), fed by pLLMAgent. Each vehicle's plan
  // lines arrive as BT_CHAT_<VNAME> and show with its name in front.
  chat_viewable        = true
  chat_width           = 28
  chat_input_lines     = 6
  chat_font_size       = 12       // Ctrl+= / Ctrl+- change it live
  chat_plan_var        = BT_CHAT_*

  // No mouse context: the vehicles are driven from the chat, the
  // buttons below and uPokeDB, never by a click on the map.
  scope = LLM_STATUS
  scope = LLM_ALERTS
  scope = LLM_TOOL_POST
  scope = DEPLOY_ALL
  scope = RETURN_ALL
  scope = MVIEWER_LCLICK

  // BT_CMD_ALL reaches every squad plan on the shoreside executor and,
  // through the qbridge, every vehicle's own plan; then the helm flags.
  button_one   = STOP_ALL # BT_CMD_ALL=halt # DEPLOY_ALL=false # RETURN_ALL=false
  button_two   = RETURN_ALL # BT_CMD_ALL=cancel # DEPLOY_ALL=true # RETURN_ALL=true # MOOS_MANUAL_OVERRIDE_ALL=false
  button_three = SLOWER # WPT_UPDATE_ALL=speed=1.0 # RETURN_UPDATE_ALL=speed=1.0
  button_four  = FASTER # WPT_UPDATE_ALL=speed=3.0 # RETURN_UPDATE_ALL=speed=3.0

  action = MENU_KEY=stop_all # BT_CMD_ALL=halt # DEPLOY_ALL=false # RETURN_ALL=false
  action = MENU_KEY=return_all # BT_CMD_ALL=cancel # DEPLOY_ALL=true # RETURN_ALL=true # MOOS_MANUAL_OVERRIDE_ALL=false
  action = MENU_KEY=alerts_off # LLM_ALERTS=off   // collisions and near misses no longer reach the agent
  action = MENU_KEY=alerts_on # LLM_ALERTS=on
}

//------------------------------------------
// uButtonPanel config block: the operator's button panel, its own
// window. One button per block of buttons.txt: the fixed ones the
// mission wrote by hand, and the ones pLLMAgent's make_button tool
// saves there (those post LLM_BUTTON=<label> and pLLMAgent runs the
// saved plan). The file is re-read whenever it changes on disk.

ProcessConfig = uButtonPanel
{
  AppTick   = 4
  CommsTick = 4

  buttons_file  = buttons.txt   // the file pLLMAgent writes too
  columns       = 2
  button_height = 40
  width         = 320
  height        = 160
}

//------------------------------------------
// pLLMAgent config block
// The API key is read from the ANTHROPIC_API_KEY environment
// variable of the shell that runs launch.sh; it is never stored here.

ProcessConfig = pLLMAgent
{
  AppTick   = 4
  CommsTick = 4

  model           = claude-opus-5-5
  effort          = low       // how long the model thinks; low replied a third faster with the same plans in the chat test
  // The model thinks before it writes and max_tokens caps both, so it
  // bounds one turn (about 60 tokens/s): everyday turns use a few
  // hundred tokens in 5 to 15 s whatever the cap, and a hard one (a
  // three-boat braid) used all of 4096 thinking and answered nothing.
  // 8192 keeps a turn under about two minutes; the timeout must sit
  // above that or a good reply is dropped and retried.
  max_tokens      = 8192
  timeout         = 300
  planning_max_tokens = 16384 // planning turns may think longer (~4.5 min at most, hence timeout 300)
  planning_effort = medium    // and deeper; mission mode keeps effort low for tempo

  // What the run costs, on the appcast and as LLM_COST: the prices
  // default to claude-opus-5-5's (price_* lines override them as they
  // change); budget is dollars for this run, left = budget - spent,
  // this agent's requests only, never the account's balance.
  budget = 20                 // edit to your allowance; 0 = none
  confirm_default = true

  // The fleet: every capability whose file names no receivers takes a
  // vname argument (all fans out over the roster) and posts
  // VAR_<VNAME>, which uFldShoreBroker bridges to that vehicle. The
  // map tools say receivers = local in their files and draw here.
  receivers = all:vname
  vnames    = $(VNAMES_CSV)      // the roster before the first NODE_REPORT

  // The squads uFldSquad keeps are the plan executor's slots, addressed
  // like a vehicle by the plan tools: run_plan vname=red posts
  // BT_TREE_RED. The names come from SQUAD_LIST as squads are formed and
  // disbanded, the members from SQUAD_REPORT_<NAME>.
  squads_var = SQUAD_LIST

  // What comes back from each vehicle, renamed with its name by its
  // uFldNodeBroker, and from each squad's plan slot; a * registers a
  // wildcard.
  watch = BT_STATE_*, BT_ACTIVE_*, BT_LOG_*, MISSION_*
  watch = BT_REPORT_*, BT_MEMBERS_*, BT_PLAN_*
  watch = IVPHELM_STATE_*, IVPHELM_UPDATE_RESULT_*
  watch = DEPLOY_ALL, RETURN_ALL
  watch = SQUAD_LIST, SQUAD_EVENT, SQUAD_REPORT_*, SQUAD_MISSION_*   // uFldSquad
  watch = COLLISION_TOTAL, NEAR_MISS_TOTAL   // uFldCollisionDetect's counts
  watch = AVOID_*                             // each vehicle's avoidance mode, as last set here

  // Events pushed to the model as [alert: ...] notes, each opening a
  // turn of its own: two vehicles within 4 m (COLLISION) or 8 m
  // (NEAR_MISS), from uFldCollisionDetect. Off at launch: a run whose
  // risk is accepted wants no intervention, and the values stay
  // readable with get_var. LLM_ALERTS=on (the viewer's Action menu, or
  // uPokeDB) turns them on, off mutes them again.
  alert     = COLLISION, NEAR_MISS
  alerts    = off
  alert_var = LLM_ALERTS

  bt_tree_var        = BT_TREE
  system_prompt_file = prompts/fleet.txt

  // helm: the single-vehicle drivers and modifiers; squad: the
  // uFldSquad tools (squad_form, squad_goto, squad_formation ...), which
  // take a squad argument and post SQUAD_CMD here (receivers = local).
  // One directory per line. contact: follow (one vehicle trails
  // another along its track), intercept (chase and close on one) and
  // avoid (collision avoidance, off at launch). The towed-sensor and
  // energy-saving pairs have no role here; every tool costs prompt
  // tokens each turn.
  capability_dir = helm
  capability_dir = squad
  capability_dir = contact
  capability_drop = turn_limit, turn_limit_off, periodic_speed, periodic_speed_off
  view_color = orange, magenta, cyan, dodger_blue, white, yellow   // yellow last: a running plan step is yellow
  preview_var = PLAN_PREVIEW   // uPlanPreview plays the proposal out on phantom boats

  // The operator's button panel (uButtonPanel shows the same file):
  // the make_button tool saves a button here with the plan it runs,
  // a press posts its label on LLM_BUTTON and the plan goes out as an
  // approved run_plan would, with no model call.
  buttons_file = buttons.txt

  // mission: act at once, short replies (a live run). planning: ask
  // before proposing, answer at length (designing a button or a plan
  // to keep). Type planning or mission in the chat to switch.
  mode = mission

  app_logging = true
}

//------------------------------------------
// pBehaviorTree config block: the squad plan executor
// One plan slot per squad uFldSquad keeps (squads_var = SQUAD_LIST): a
// squad's variables carry its suffix, so a plan reaches red as
// BT_TREE_RED the way a vehicle's reaches abe as BT_TREE_ABE, and two
// squads run two plans at once. A squad plan starts with a bare <Squad>
// (the whole squad, from SQUAD_REPORT_<NAME>) and drives no vehicle
// itself: each Member block (or leaf with a vname) goes down as that
// vehicle's own plan, BT_TREE_<VNAME>, and the block waits on
// BT_STATE_<VNAME>; the squad leaves (SquadFormation, SquadGoto ...)
// run here and post SQUAD_CMD. Report lines come back up as
// BT_REPORT_<VNAME> (and back down to every vehicle under that name,
// see uFldShoreBroker); Signal goes down as BT_SIGNAL. BT_PLAN_<SQUAD>
// names the running plan, which uFldSquad shows per squad. A disbanded
// squad's plan is halted with it. No halt or fail flags: a halt
// reaches the members through their own executors.

ProcessConfig = pBehaviorTree
{
  AppTick   = 4
  CommsTick = 4

  squads_var = SQUAD_LIST
  vnames    = $(VNAMES_CSV)      // the fleet, before the first NODE_REPORT

  capability_dir = helm          // the same leaves the vehicles have
  capability_dir = squad          // the squad leaves, run on this executor
  capability_dir = contact       // follow, intercept, avoid, dispatched to the vehicle
  view_prefix    = bt_           // shapes labelled bt_<squad>_...
  contacts       = true          // ABE_BEN_RANGE and friends for conditions

  app_logging = true
}

//------------------------------------------
// uFldSquad config block: squads as objects
// SQUAD_CMD creates and disbands squads of these vehicles and moves
// them: "move red to x,y" moves the squad's centroid there, every
// member keeping its offset, or holding a slot of a formation. Each
// squad's centroid, spread and state come out as SQUAD_REPORT_<NAME>
// and SQUAD_<NAME>_X/_Y/...; members take the squad color on the map.
// Vehicles are driven through the same posts the goto, speed and
// stop tools make, bridged down by uFldShoreBroker.

ProcessConfig = uFldSquad
{
  AppTick   = 4
  CommsTick = 4

  vnames    = $(VNAMES_CSV)      // the fleet, before the first NODE_REPORT
  speed     = 2.0
  release_speed   = 2.0          // a member's waypoint speed once let go; the
                                 // slot legs run at 1.2 and the helm keeps it
  contact_max_age = 30

  app_logging = true
}

//------------------------------------------------------------
// uPlanPreview config block: while a proposal waits for y/n, phantom
// boats play it out on the map (pLLMAgent's preview_var sends it).
// The same capability sets as pLLMAgent and pBehaviorTree, so every
// leaf a plan may use is known here with its ghost line.

ProcessConfig = uPlanPreview
{
  AppTick   = 4
  CommsTick = 4

  request_var = PLAN_PREVIEW
  capability_dir = helm
  capability_dir = squad
  capability_dir = contact
  capability_drop = turn_limit, turn_limit_off, periodic_speed, periodic_speed_off

  rate       = 10     // plan seconds per MOOS second
  loop       = true   // replay while the proposal waits
  loop_pause = 5
}
